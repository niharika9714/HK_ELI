{
  "id": "client-briefing",
  "version": "1",
  "enabled": false,
  "status": "draft",
  "title": "Client Briefing",
  "audience": "One named client or prospect",
  "audience_type": "external",
  "classification": "Internal — draft classification pending owner review",
  "disabled_reason": "External wording and client-scoped disclosure policy have not been approved.",
  "use_when": [
    "Client discussion pack",
    "External briefing",
    "Client meeting pre-read"
  ],
  "do_not_use_when": [
    "Internal management or cross-client analysis"
  ],
  "files": {
    "pptx": "client-briefing/v1/template.pptx",
    "docx": "client-briefing/v1/template.docx"
  },
  "instructions_file": "client-briefing/v1/instructions.md",
  "sections": [
    {
      "id": "summary",
      "title": "Purpose and agenda",
      "required": true,
      "max_items": 4,
      "max_images": 0
    },
    {
      "id": "findings",
      "title": "Your ELI portfolio",
      "required": false,
      "max_items": 8,
      "max_images": 0
    },
    {
      "id": "actions",
      "title": "Questions and next steps",
      "required": true,
      "max_items": 4,
      "max_images": 0
    },
    {
      "id": "evidence",
      "title": "Important information",
      "required": true,
      "max_items": 12,
      "max_images": 0
    }
  ],
  "limits": {
    "max_body_slides": 12,
    "max_total_slides": 60,
    "max_pages": 20,
    "max_rows_per_sheet": 100000,
    "max_columns": 50
  },
  "missing_data_policy": "disclose",
  "freshness_days": null,
  "branding_status": "Reference-inspired; official logo and approval pending",
  "pptx_layout": {
    "title_box": [
      0.7,
      0.5,
      11.9,
      1.1
    ],
    "body_box": [
      0.7,
      1.7,
      11.9,
      4.6
    ],
    "footer_box": [
      0.7,
      6.65,
      11.9,
      0.65
    ],
    "font": "Arial",
    "title_color": "C00000",
    "body_color": "1A1A1A",
    "caption_color": "5F5F5F",
    "title_size": 28,
    "body_size": 16
  },
  "pdf_rendering": "Native PDF with shared outline; not a DOCX conversion or guaranteed page-identical copy",
  "provenance": "Supplied HK ELI Document Templates.pdf and synthetic executive PPTX; spreadsheet structure inspected, figures excluded."
}
